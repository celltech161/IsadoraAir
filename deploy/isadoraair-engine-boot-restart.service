[Unit]
Description=Restart isadoraair-engine.service if silence is detected (fired once by isadoraair-engine-boot-restart.timer)
# Depends on encoders because the silence-detector state file we read
# is written by liquidsoap's blank.detect inside that service.
After=isadoraair-engine.service isadoraair-encoders.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/isadoraair-engine-boot-restart.sh
