[Unit]
Description=Syndicated ingestion: Acoustic Cafe (show + promo variants, deliver, analyze)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@@ISA_USER@@
Group=@@ISA_USER@@
WorkingDirectory=@@SYNDICATED_ROOT@@/acafe
ExecStart=@@SYNDICATED_ROOT@@/venv/bin/python @@SYNDICATED_ROOT@@/acafe/get_acafe.py
TimeoutStartSec=900
