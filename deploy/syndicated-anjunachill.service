[Unit]
Description=Syndicated ingestion: Anjunachill On Air (login, scrape, tag, artwork, deliver, analyze)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@@ISA_USER@@
Group=@@ISA_USER@@
WorkingDirectory=@@SYNDICATED_ROOT@@/anjunachill
ExecStart=@@SYNDICATED_ROOT@@/venv/bin/python @@SYNDICATED_ROOT@@/anjunachill/get_anjunachill.py
TimeoutStartSec=600
