[Unit]
Description=Current temperature announcer (Piper TTS -> WxTemp)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@@ISA_USER@@
Group=@@ISA_USER@@
WorkingDirectory=@@WEATHER_ROOT@@
ExecStart=@@WEATHER_ROOT@@/venv/bin/python @@WEATHER_ROOT@@/current_temp.py --voice auto
