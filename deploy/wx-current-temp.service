[Unit]
Description=Current temperature announcer (Piper TTS -> WxTemp)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jreed
Group=jreed
WorkingDirectory=/home/jreed/weather-ingest
ExecStart=/home/jreed/weather-ingest/venv/bin/python /home/jreed/weather-ingest/current_temp.py --voice auto
