[Unit]
Description=Synthesize spoken dedication intros for scheduled web requests

[Timer]
# Kept independent of web-requests-poll.timer's 20s cadence (which drives
# refresh_song_request_statuses) deliberately -- Kokoro+ffmpeg together
# can take tens of seconds worst case, and that reconciliation command
# must stay fast and reliable (stranded-request detection, self-heal).
# A command-wide advisory lock (see generate_dedication_intros) means an
# overlapping firing just exits immediately rather than racing itself.
OnBootSec=30s
OnUnitActiveSec=15s
Persistent=false

[Install]
WantedBy=timers.target
