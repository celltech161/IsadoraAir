[Unit]
Description=1-day (current observation) forecast announcer, day voice (Piper TTS -> WxObs)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jreed
Group=jreed
WorkingDirectory=/home/jreed/weather-ingest
ExecStart=/home/jreed/weather-ingest/venv/bin/python /home/jreed/weather-ingest/wx_forecast.py --mode 1day --voice day
