[Unit]
Description=IsadoraAir background track analysis (waveform + cue points for any unanalyzed track)
After=network.target postgresql.service

[Service]
Type=oneshot
User=jreed
Group=jreed
WorkingDirectory=/opt/isadoraair
ExecStart=/opt/isadoraair/venv/bin/python /opt/isadoraair/manage.py analyze_tracks
EnvironmentFile=/opt/isadoraair/.env
