server {
    listen 80;
    server_name isadoraair 192.168.1.125;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name isadoraair 192.168.1.125;

    ssl_certificate     /etc/ssl/isadoraair/selfsigned.crt;
    ssl_certificate_key /etc/ssl/isadoraair/selfsigned.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 1G;

    location /static/ {
        alias /opt/isadoraair/staticfiles/;
        expires 1h;
    }

    # Remote DJ over WebRTC signaling (SDP/ICE JSON only -- the actual
    # RTP/RTCP/DTLS-SRTP media never touches nginx, it's a separate direct
    # UDP flow ICE establishes once signaling completes). Proxied to the
    # signaling server's own port, separate from gunicorn's 8000.
    location /ws/remote-dj/ {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        # signaling socket sits open+idle for a whole DJ segment; default
        # 60s would kill it mid-session.
        proxy_read_timeout 3600s;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
