[Unit]
Description=Syndicated ingestion: Retro Cocktail Hour (Selenium scrape, tag, promo, deliver, analyze)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@@ISA_USER@@
Group=@@ISA_USER@@
WorkingDirectory=@@SYNDICATED_ROOT@@/rch
ExecStart=@@SYNDICATED_ROOT@@/venv/bin/python @@SYNDICATED_ROOT@@/rch/get_rch.py
TimeoutStartSec=1800
