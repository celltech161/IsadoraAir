[Unit]
Description=Syndicated ingestion: The Local Show with Morgan (fetch, tag, deliver, analyze)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@@ISA_USER@@
Group=@@ISA_USER@@
WorkingDirectory=@@SYNDICATED_ROOT@@/warrior
ExecStart=@@SYNDICATED_ROOT@@/venv/bin/python @@SYNDICATED_ROOT@@/warrior/get_local_show.py
