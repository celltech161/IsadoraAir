[Unit]
Description=Syndicated ingestion: Enhanced Sessions (login, scrape, station-ID insert, deliver, analyze)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@@ISA_USER@@
Group=@@ISA_USER@@
WorkingDirectory=@@SYNDICATED_ROOT@@/enhanced
ExecStart=@@SYNDICATED_ROOT@@/venv/bin/python @@SYNDICATED_ROOT@@/enhanced/get_enhanced.py
TimeoutStartSec=1800
