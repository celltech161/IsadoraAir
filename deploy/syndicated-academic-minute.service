[Unit]
Description=Syndicated ingestion: The Academic Minute (fetch, tag, deliver, analyze)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@@ISA_USER@@
Group=@@ISA_USER@@
WorkingDirectory=@@SYNDICATED_ROOT@@/academic_minute
ExecStart=@@SYNDICATED_ROOT@@/venv/bin/python @@SYNDICATED_ROOT@@/academic_minute/get_academic_minute.py
