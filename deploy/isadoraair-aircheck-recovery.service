[Unit]
Description=IsadoraAir Aircheck pending-finalization retry and recovery retention
After=network.target postgresql.service isadoraair-encoders.service

[Service]
Type=oneshot
Nice=19
User=@@ISA_USER@@
Group=@@ISA_USER@@
WorkingDirectory=@@ISA_ROOT@@
ExecStart=@@ISA_ROOT@@/venv/bin/python @@ISA_ROOT@@/manage.py maintain_aircheck_recovery
EnvironmentFile=@@ISA_ROOT@@/.env
