[Unit]
Description=IsadoraAir Gunicorn
After=network.target postgresql.service

[Service]
User=@@ISA_USER@@
Group=@@ISA_USER@@
WorkingDirectory=@@ISA_ROOT@@
ExecStart=@@ISA_ROOT@@/venv/bin/gunicorn isadoraair.wsgi:application --bind 127.0.0.1:8000 --workers 3
Restart=on-failure
RestartSec=5
EnvironmentFile=@@ISA_ROOT@@/.env
# iPortal media validation (2.22B): delegate this unit's cgroup subtree to the
# service account and run Gunicorn in its "web" subgroup, so
# production.services.confinement can run every validator in a kernel-limited,
# killable per-run cgroup beside it (<unit>/iportal-validation/run-*), without
# privilege. Without the delegation, validation fails closed.
Delegate=cpu memory pids
DelegateSubgroup=web

[Install]
WantedBy=multi-user.target
