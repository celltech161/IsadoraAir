[Unit]
Description=Syndicated ingestion: Kansas News Service (scrape, select, loudnorm, deliver, analyze)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@@ISA_USER@@
Group=@@ISA_USER@@
WorkingDirectory=@@SYNDICATED_ROOT@@/kns
ExecStart=@@SYNDICATED_ROOT@@/venv/bin/python @@SYNDICATED_ROOT@@/kns/get_kns.py
TimeoutStartSec=1800
