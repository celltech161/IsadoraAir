[Unit]
Description=Syndicated ingestion: Floydian Slip (fetch, tag, deliver, analyze)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@@ISA_USER@@
Group=@@ISA_USER@@
WorkingDirectory=@@SYNDICATED_ROOT@@/floyd
ExecStart=@@SYNDICATED_ROOT@@/venv/bin/python @@SYNDICATED_ROOT@@/floyd/get_floyd.py
