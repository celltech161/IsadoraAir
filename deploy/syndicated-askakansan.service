[Unit]
Description=Syndicated ingestion: Ask A Kansan (fetch, fit, tag, artwork, deliver, analyze)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@@ISA_USER@@
Group=@@ISA_USER@@
WorkingDirectory=@@SYNDICATED_ROOT@@/askakansan
ExecStart=@@SYNDICATED_ROOT@@/venv/bin/python @@SYNDICATED_ROOT@@/askakansan/get_ask_a_kansan.py
