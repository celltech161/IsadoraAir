[Unit]
Description=Post now-playing to Bluesky
After=isadoraair-engine.service
Wants=isadoraair-engine.service

[Service]
Type=oneshot
User=@@ISA_USER@@
Group=@@ISA_USER@@
WorkingDirectory=@@SYNDICATED_ROOT@@/bsky
ExecStart=@@SYNDICATED_ROOT@@/venv/bin/python @@SYNDICATED_ROOT@@/bsky/post_now_playing.py
