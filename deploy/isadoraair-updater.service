# OBSOLETE, PRE-PHASE-D LEGACY MATERIAL -- retained for historical/
# rollback/release-chain context only (r0003-r0006 manual bridge era;
# see docs/UPDATE_CENTER.md's own historical runbook). Superseded by the
# Phase-D bootstrap supervisor (deploy/updater-bootstrapd.service) --
# see docs/UPDATE_CENTER_PHASE_D.md's "Legacy updater retirement"
# section. On a completed Phase-D station this unit must be MASKED, not
# merely disabled (deploy/updater_bootstrap/tools/
# legacy_updater_retirement.py). Do not install/enable/start this unit
# on a station that already has a working Phase-D supervisor -- its
# ExecStart/config contract predates the phase_d_* station-config
# fields entirely and will crash-loop, and it shares RuntimeDirectory=
# isadoraair-updater with the live supervisor-owned worker socket.
[Unit]
Description=IsadoraAir protected update executor
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=@@ISA_USER@@
ExecStart=/usr/bin/python3 -I /usr/local/libexec/isadoraair-updater/updaterd.py --config /etc/isadoraair/station.json
Restart=on-failure
RestartSec=5
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
RuntimeDirectory=isadoraair-updater
RuntimeDirectoryMode=0750
StateDirectory=isadoraair-updater
StateDirectoryMode=0750
LogsDirectory=isadoraair-updater
LogsDirectoryMode=0700
NoNewPrivileges=true
AmbientCapabilities=CAP_SETUID CAP_SETGID
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/isadoraair-updater /var/log/isadoraair-updater /var/backups/isadoraair/update-checkpoints /var/lib/alsa /etc/systemd/system @@ISA_ROOT@@

[Install]
WantedBy=multi-user.target
