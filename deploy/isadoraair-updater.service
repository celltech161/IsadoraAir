[Unit]
Description=IsadoraAir protected update executor
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=@@ISA_USER@@
ExecStart=/usr/bin/python3 -I /usr/local/libexec/isadoraair-updater/updaterd.py --config /etc/isadoraair/station.json
Restart=on-failure
RestartSec=5
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
RuntimeDirectory=isadoraair-updater
RuntimeDirectoryMode=0750
StateDirectory=isadoraair-updater
StateDirectoryMode=0750
LogsDirectory=isadoraair-updater
LogsDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/isadoraair-updater /var/log/isadoraair-updater /var/backups/isadoraair/update-checkpoints /var/lib/alsa /etc/systemd/system @@ISA_ROOT@@

[Install]
WantedBy=multi-user.target
