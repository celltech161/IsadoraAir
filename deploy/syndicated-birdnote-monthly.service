[Unit]
Description=Syndicated ingestion: BirdNote Daily monthly ZIP download+extract
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@@ISA_USER@@
Group=@@ISA_USER@@
WorkingDirectory=@@SYNDICATED_ROOT@@/birdnote
ExecStart=@@SYNDICATED_ROOT@@/venv/bin/python @@SYNDICATED_ROOT@@/birdnote/dl_birdnote.py
TimeoutStartSec=600
