[Unit]
Description=1-day (current observation) forecast announcer, night voice (Piper TTS -> WxObs)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@@ISA_USER@@
Group=@@ISA_USER@@
WorkingDirectory=@@WEATHER_ROOT@@
ExecStart=@@WEATHER_ROOT@@/venv/bin/python @@WEATHER_ROOT@@/wx_forecast.py --mode 1day --voice night
