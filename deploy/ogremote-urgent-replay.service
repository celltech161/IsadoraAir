[Unit]
Description=OGRemote urgent PA/PSA replay check (re-fires insert_urgent while a message is still active)
After=network-online.target

[Service]
Type=oneshot
User=@@ISA_USER@@
Group=@@ISA_USER@@
WorkingDirectory=@@OGREMOTE_ROOT@@
ExecStart=@@OGREMOTE_ROOT@@/venv/bin/python @@OGREMOTE_ROOT@@/urgent_pa.py --periodic
