[Unit]
Description=OGRemote urgent PA/PSA replay check (re-fires insert_urgent while a message is still active)
After=network-online.target

[Service]
Type=oneshot
User=jreed
Group=jreed
WorkingDirectory=/home/jreed/ogremote-ingest
ExecStart=/home/jreed/ogremote-ingest/venv/bin/python /home/jreed/ogremote-ingest/urgent_pa.py --periodic
