[Unit]
Description=IsadoraAir KDOT CARS road-conditions sync
After=network-online.target postgresql.service isadoraair-generate-road-condition-audio.path
Wants=network-online.target
# A missing or inactive watcher must fail the scheduled job visibly.
# Requisite leaves activation of the watcher with the station operator.
Requisite=isadoraair-generate-road-condition-audio.path

[Service]
Type=oneshot
User=@@ISA_USER@@
Group=@@ISA_USER@@
WorkingDirectory=@@ISA_ROOT@@
ExecStart=@@ISA_ROOT@@/venv/bin/python @@ISA_ROOT@@/manage.py sync_road_conditions
EnvironmentFile=@@ISA_ROOT@@/.env
