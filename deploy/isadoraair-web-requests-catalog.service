[Unit]
Description=IsadoraAir public-site listener request catalog sync
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=@@ISA_USER@@
Group=@@ISA_USER@@
WorkingDirectory=@@ISA_ROOT@@
EnvironmentFile=@@ISA_ROOT@@/.env
ExecStart=@@ISA_ROOT@@/venv/bin/python @@ISA_ROOT@@/manage.py sync_web_request_catalog
TimeoutStartSec=120
