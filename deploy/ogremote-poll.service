[Unit]
Description=OGRemote available-uploads poller (download/process/deliver + recall handling)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@@ISA_USER@@
Group=@@ISA_USER@@
WorkingDirectory=@@OGREMOTE_ROOT@@
ExecStart=@@OGREMOTE_ROOT@@/venv/bin/python @@OGREMOTE_ROOT@@/get_available_uploads.py
